# ── DB (Supabase 연동을 쓰면 POSTGRES_URL 이 자동으로 들어오고, 직접 넣으면 이 값이 우선) ──
DATABASE_URL=postgresql://a11y:a11y@localhost:5432/a11ynote
# 마이그레이션은 연결 풀러가 아닌 직접 연결 주소로 (Supabase 5432 포트)
DIRECT_URL=

# ── 로그인 (Supabase 매직 링크). 비우면 개발용 로그인만 가능 ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 캡처 저장소 (private 버킷 a11y-shots). 서버 전용, 절대 브라우저·확장에 넣지 말 것
SUPABASE_SERVICE_ROLE_KEY=
A11Y_SHOTS_BUCKET=a11y-shots

# 개발용 로그인 (운영에서는 무시됨)
DEV_LOGIN_ENABLED=1
NEXT_PUBLIC_SITE_URL=http://localhost:3200

# ── AI 판정 (없으면 규칙 기반 판정으로 동작) ──
# gemini 권장 / anthropic 비교용
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_PRICE_INPUT_PER_MTOK=0.75
GEMINI_PRICE_OUTPUT_PER_MTOK=3.75
ANTHROPIC_API_KEY=
# 여러 워크스페이스에 연결된 키를 사용할 때 필수 (Claude Console의 wrkspc_... ID)
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
AI_DAILY_BUDGET_USD=5
# 1백만 토큰당 달러 (예산 계산용 대략값 — 모델 가격이 바뀌면 고칠 것)
AI_PRICE_INPUT_PER_MTOK=1
AI_PRICE_OUTPUT_PER_MTOK=5
AI_CONFIDENCE_THRESHOLD=0.75

# ── 검사 워커 ──
CHROMIUM_PATH=/opt/pw-browsers/chromium

# ── 기능 플래그 (기본 전부 꺼짐, on 일 때만 켜짐) ──
# FLOW_AUTOTRY=on
# FLOW_SEARCH=on
# FLOW_EMPTY_SUBMIT=on
# AI_FLOWS=on

# ── 검사 워커 외부 접속 (SSRF 방어) ──
# 개발용 허용 목록 (운영 NODE_ENV=production 에서는 무시됨). 테스트 사이트용.
EGRESS_ALLOW_HOSTS=localhost:4400
# 회차·화면 실행 한도 (밀리초)
# SCAN_LIMIT_MS=1200000
# PAGE_LIMIT_MS=60000

# ── 크롬 확장 연결 (P0-4) ──
# 운영에서 허용할 확장 출처 (웹스토어 배포 ID)
# EXTENSION_ORIGINS=chrome-extension://<확장 ID>
# 연결 키 유효기간(일), 프로젝트당 하루 업로드 화면 수
# UPLOAD_TOKEN_DAYS=90
# 비상용: 설정하면 사용 한도의 확장 하루 업로드 한도를 덮어씀 (평소에는 비워 둠)
# EXT_DAILY_LIMIT=500

# ── 웹 ↔ 워커 공유 비밀 (32자 이상, openssl rand -hex 32). 웹·워커 둘 다 같은 값 ──
# WORKER_SHARED_SECRET=
# 워커 전용: 웹 앱 주소 (캡처 저장·정리·생존 신호). 웹에는 넣지 말 것
# WORKER_APP_URL=https://a11ynote.example.com
# 워커 전용: DB 는 a11y_worker 역할로 접속 (DATABASE_URL 에 그 계정을 넣는다)
# 운영 워커는 네트워크 격리 확인을 끌 수 없음 (NODE_ENV=production 이면 자동으로 켜짐)
# REQUIRE_ISOLATION=1

# ── 개인정보 ──
# 캡처 보관 기간(일)
# SHOT_RETENTION_DAYS=90

# ── 운영 설정 점검 (P1-8) ──
# 서버 시작 시 scripts/preflight.ts 와 같은 점검을 하고, 오류가 있으면 요청을 처리하지 않는다.
# PREFLIGHT_SKIP=1 은 로컬에서 운영 빌드를 시험할 때만. 운영에서 설정하면 그 자체가 오류.
# 헬스 체크에 표시할 버전 (Vercel 은 자동)
# GIT_SHA=
