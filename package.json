{
  "name": "a11ynote",
  "version": "0.1.0",
  "private": true,
  "description": "접근성 점검노트 — 웹 접근성 자체진단 점검표·보고서 자동 작성 웹 앱",
  "scripts": {
    "preinstall": "node scripts/check-node.cjs",
    "dev": "next dev -p 3200",
    "build": "npm run build:core && next build",
    "start": "next start -p 3200",
    "build:core": "tsx scripts/build-core.ts",
    "worker": "tsx worker/main.ts",
    "fixture": "tsx fixtures/serve.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "pack:ext": "bash scripts/pack-extension.sh"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "axe-core": "^4.14.0",
    "docx": "^9.9.0",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "jszip": "3.10.2",
    "next": "^14.2.35",
    "playwright-core": "^1.64.0",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "dotenv": "^18.0.6",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.29",
    "tailwindcss": "3.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": "22.x"
  }
}
